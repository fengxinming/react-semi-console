.navbar
  display flex
  justify-content space-between
  border-bottom 1px solid var(--semi-color-border)
  box-sizing border-box
  background-color var(--semi-color-bg-0)
  height 100%
  width 100%

.left
  display flex
  align-items center
  gap 16px

.logo
  display flex
  align-items center
  width 100%
  min-width 0
  padding-left 20px
  box-sizing border-box

.logo-name
  color var(--semi-color-text-0)
  font-weight 500
  font-size 20px
  margin-left 10px
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.collapse-toggle
  display inline-flex
  align-items center
  justify-content center
  width 32px
  height 32px
  border-radius 4px
  cursor pointer
  color var(--semi-color-text-1)
  margin-left 20px

  &:hover
    background var(--semi-color-fill-1)
    color var(--semi-color-primary)

.username
  cursor pointer

.right
  display flex
  flex-shrink 1
  min-width 0
  overflow-x auto
  list-style none
  padding-right 20px
  margin 0

  li
    padding 0 8px
    display flex
    align-items center
    flex-shrink 0

  a
    text-decoration none
    color var(--semi-color-text-0)

.menu-wide
  width 640px

.icon-button
  font-size 16px
  border 1px solid var(--semi-color-border)

  > svg
    vertical-align -3px

// 消息浮层：外框（背景/圆角/阴影）由 Semi Popover 容器提供，这里只负责尺寸与滚动，
// 否则会形成内外两层框，中间多出一圈空白
// / Notice popup: the outer frame (background/radius/shadow) comes from Semi's Popover container;
// this only handles size and scrolling, otherwise you get a double frame with a blank gutter.
.notice-panel
  width 400px
  max-height 800px
  overflow-y auto

  // Semi Tabs：头部导航 .semi-tabs-bar，面板区 .semi-tabs-content
  // / Semi Tabs: header bar .semi-tabs-bar, panel area .semi-tabs-content
  :global(.semi-tabs-bar)
    padding 8px 16px
    // 清掉 Tabs 自带的下外边距，否则标签分隔线与列表之间会空出一条
    // / clear Tabs' default bottom margin, which would leave a gap above the list
    margin 0

  :global(.semi-tabs-content)
    padding-top 0

  // 列表项左右留白与 Tabs 的 16px 对齐（Semi List 默认内边距不同，
  // 这里显式写出来，避免 token 变化后内容贴到弹层边缘）
  // / Align the list item's horizontal padding with the Tabs' 16px
  :global(.semi-list-item)
    padding 12px 16px

    // Semi List 默认带 hover 底色与末项分隔线，这里还原成原视觉
    // / Semi List ships a hover background and a trailing divider by default; revert both
    &:hover
      background-color transparent

    &:last-child
      border-bottom none

// 列表项里自己拼的两栏布局，取代原 List.Item.Meta
// / Two-column layout composed inside the list item, replacing List.Item.Meta
.notice-item
  display flex
  align-items flex-start
  gap 16px
  cursor pointer

.notice-item-content
  flex 1
  min-width 0

// 列表项标题：用 Typography.Title 渲染，清掉默认外边距
// / List item title rendered with Typography.Title, with default margins cleared
.notice-item-title
  margin 0 0 4px

.notice-empty
  padding 24px 0
  text-align center
  color var(--semi-color-text-2)

.notice-content
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  color var(--semi-color-text-1)
  font-size 13px

// 弹层底部操作区（Semi List 无 footer 插槽，单独渲染）
// / Popup footer actions (Semi List has no footer slot, so it is rendered separately)
.notice-footer
  display flex
  padding 12px 0

.notice-footer-item
  display flex
  justify-content center
  width 50%

  &:first-child
    border-right 1px solid var(--semi-color-border)

// 搜索框：className 直接落在 Semi Input 的根节点上（即 .semi-input-wrapper），
// 因此背景与圆角写在 .search-box 自身
// / search input: className lands on Semi Input's root (.semi-input-wrapper), so the
// background/radius go on .search-box itself
.search-box
  background-color var(--semi-color-fill-1)
  border-radius 16px

  svg
    font-size 16px

.search-item
  padding 8px 12px
  border-radius 6px
  cursor pointer

  &:hover
    background var(--semi-color-fill-1)

.search-empty
  padding 24px 0
  text-align center
  color var(--semi-color-text-2)

.dropdown-icon
  margin-right 8px
  font-size 16px
  vertical-align text-bottom

@media (max-width: 768px)
  .logo-name
    display none