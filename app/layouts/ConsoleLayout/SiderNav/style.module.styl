.layout-sider
  position fixed
  height 100%
  top 0
  left 0
  z-index 99
  box-sizing border-box
  // padding-top 60px
  background-color var(--semi-color-bg-0)

  &.no-header
    padding-top 0
    min-height 100vh

  ::-webkit-scrollbar
    width 12px
    height 4px

  ::-webkit-scrollbar-thumb
    border 4px solid transparent
    background-clip padding-box
    border-radius 7px
    background-color var(--semi-color-text-3)

  ::-webkit-scrollbar-thumb:hover
    background-color var(--semi-color-text-2)

  &::after
    content ''
    display block
    position absolute
    top 0
    right -1px
    width 1px
    height 100%
    background-color var(--semi-color-border)

  // Semi Sider 的内容容器 / Semi Sider content wrapper
  > :global(.semi-layout-sider-children)
    position relative
    height 100%
    overflow visible

  .collapse-btn
    position absolute
    top 50%
    right -16px
    transform translateY(-50%)
    width 16px
    height 60px
    background-color var(--semi-color-fill-0)
    color var(--semi-color-text-1)
    clip-path polygon(0 0, 100% 25%, 100% 75%, 0 100%)
    cursor pointer
    display flex
    justify-content center
    align-items center
    z-index 2

    &:hover
      background-color var(--semi-color-fill-2)

.menu-wrapper
  overflow-y auto
  overflow-x hidden
  height 100%
  box-sizing border-box

  :global(.semi-navigation)
    width 100% !important
    min-width 0

  // Semi Nav 的子菜单标题 = .semi-navigation-sub-title
  // / Semi Nav submenu title = .semi-navigation-sub-title
  :global(.semi-navigation-sub-title)
    font-weight 500
