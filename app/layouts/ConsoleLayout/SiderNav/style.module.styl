.layout-sider
  position fixed
  height 100%
  top 0
  left 0
  z-index 99
  box-sizing border-box
  // padding-top 60px
  background-color var(--ant-color-bg-layout)

  &.no-header
    padding-top 0
    min-height 100vh

  ::-webkit-scrollbar
    width 12px
    height 4px

  ::-webkit-scrollbar-thumb
    border 4px solid transparent
    background-clip padding-box
    border-radius 7px
    background-color var(--ant-color-text-quaternary)

  ::-webkit-scrollbar-thumb:hover
    background-color var(--ant-color-text-tertiary)

  &::after
    content ''
    display block
    position absolute
    top 0
    right -1px
    width 1px
    height 100%
    background-color var(--ant-color-border-secondary)

  // antd Sider 的内容容器 / antd Sider content wrapper
  > :global(.ant-layout-sider-children)
    overflow-y hidden

  .collapse-btn
    height 24px
    width 24px
    background-color var(--ant-color-fill)
    color var(--ant-color-text-tertiary)
    border-radius 2px
    cursor pointer
    display flex
    justify-content center
    align-items center
    position absolute
    bottom 12px
    right 12px

    &:hover
      background-color var(--ant-color-fill-tertiary)

.menu-wrapper
  overflow auto
  height 100%

  // antd 子菜单标题 = .ant-menu-submenu-title（原 arco-menu-inline-header 的等价节点）
  // / antd submenu title = .ant-menu-submenu-title
  :global(.ant-menu-submenu-title)
    font-weight 500
