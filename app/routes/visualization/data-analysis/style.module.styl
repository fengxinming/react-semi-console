.wrapper
  margin-top 16px

  // Semi 栅格：Row = .semi-row，Col = .semi-col
  // / Semi grid: Row = .semi-row, Col = .semi-col
  :global(.semi-row)
    align-items stretch

  :global(.semi-col)
    display flex
    flex-direction column

.card
  display flex
  flex 1
  box-sizing border-box
  height 100%
  padding 20px
  padding-top 16px
  border-radius 4px
  min-height 100px

  // 三张迷你统计卡的渐变底色取自 blue / green / purple 预设色板的第 1→2 档
  // / The three mini stat cards take their gradient from the blue / green / purple
  // preset palette (step 1 → 2)
  &-line
    background linear-gradient(180deg, #e6f4ff 0%, #bae0ff 100%)

  &-interval
    background linear-gradient(180deg, #f6ffed 0%, #d9f7be 100%)

  &-pie
    background linear-gradient(180deg, #f9f0ff 0%, #efdbff 100%)

  // 数值区（Statistic 已由普通元素替代）
  // / value area (Statistic replaced by plain elements)
  .value
    margin-top 24px
    margin-bottom 4px
    font-size 24px
    line-height 28px
    font-weight 600

  .compare-yesterday-text
    font-size 12px
    font-weight 400
    color var(--semi-color-text-1)

  .diff
    margin-left 8px
    line-height 20px
    color var(--semi-color-danger)

  .diff-increment
    color var(--semi-color-success)
