.wrapper
  margin-top 16px

  // antd 栅格：Row = .ant-row，Col = .ant-col
  // / antd grid: Row = .ant-row, Col = .ant-col
  :global(.ant-row)
    align-items stretch

  :global(.ant-col)
    display flex
    flex-direction column

.card
  display flex
  flex 1
  box-sizing border-box
  height 100%
  padding 20px
  padding-top 16px
  border-radius 4px
  min-height 100px

  // 三张迷你统计卡的渐变底色取自 antd 预设色板（blue / green / purple 的第 1→2 档）。
  // 色板变量在深浅主题下会自动换值，所以原先手写的深色分支已删除。
  // / The three mini stat cards take their gradient from antd's preset palette
  // (blue / green / purple, step 1 → 2). These vars swap values per theme, so the
  // hand-written dark-mode branch was removed.
  &-line
    background linear-gradient(180deg, var(--ant-blue-1) 0%, var(--ant-blue-2) 100%)

  &-interval
    background linear-gradient(180deg, var(--ant-green-1) 0%, var(--ant-green-2) 100%)

  &-pie
    background linear-gradient(180deg, var(--ant-purple-1) 0%, var(--ant-purple-2) 100%)

  // antd Statistic：内容容器 .ant-statistic-content，数值 .ant-statistic-content-value
  // / antd Statistic: content wrapper .ant-statistic-content, number .ant-statistic-content-value
  :global(.ant-statistic-content)
    margin-top 24px
    margin-bottom 4px

    :global(.ant-statistic-content-value)
      font-size 24px
      line-height 28px

  .compare-yesterday-text
    font-size 12px
    font-weight 400
    color var(--ant-color-text-secondary)

  .diff
    margin-left 8px
    line-height 20px
    color var(--ant-color-error)

  .diff-increment
    color var(--ant-color-success)
