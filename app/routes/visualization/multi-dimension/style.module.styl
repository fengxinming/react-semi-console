.top-row
  // antd 栅格：Row = .ant-row，Col = .ant-col
  // / antd grid: Row = .ant-row, Col = .ant-col
  :global(.ant-row)
    align-items stretch

  :global(.ant-col)
    display flex
    flex-direction column

// 指标卡：Card 根 = .ant-card，卡体 = .ant-card-body
// / metric card: card root .ant-card, card body .ant-card-body
.stat-item
  :global(.ant-card-body)
    padding-top 6px

  h6
    font-size 12px
    margin-bottom 8px

  .content
    display flex
    line-height 32px

    &-icon
      width 32px
      height 32px
      line-height 32px
      border-radius 6px
      margin-right 8px
      text-align center
      font-size 18px

    // antd Statistic 根节点 .ant-statistic
    // / antd Statistic root .ant-statistic
    :global(.ant-statistic)
      line-height normal

    // antd Skeleton 段落：className 落在 ul.ant-skeleton-paragraph 上，占位行是其 li
    // / antd Skeleton paragraph: className lands on ul.ant-skeleton-paragraph, rows are its li
    .skeleton
      > li
        height 32px

.content-source
  &-legend
    display flex
    flex-wrap wrap
    gap 16px
    justify-content center
    margin-bottom 12px

    &-item
      display inline-flex
      align-items center
      font-size 12px
      color var(--ant-color-text-secondary)

    &-dot
      display inline-block
      width 8px
      height 8px
      margin-right 6px
      border-radius 50%

.card-block
  // antd Statistic：内容容器 .ant-statistic-content，数值 .ant-statistic-content-value
  // / antd Statistic: content wrapper .ant-statistic-content, number .ant-statistic-content-value
  :global(.ant-statistic-content)
    margin-top 12px
    margin-bottom 4px
    display flex

    :global(.ant-statistic-content-value)
      font-size 24px
      line-height 28px

  .diff
    margin-left 12px
    line-height 20px
    color var(--ant-color-error)

  .diff-increment
    color var(--ant-color-success)