// 头像悬浮换图角标（组件库 Upload 自带节点）在本页 JSX 中并未渲染，相关规则历史上已删除，
// 此文件只保留页面自身的布局样式。
// / The avatar hover "change photo" badge (a node Upload would render) is not rendered by this
// page's JSX, so those rules were removed earlier; this file only carries the page's own layout.

.info-content
  flex 1
  width 0
  margin-left 60px
  padding-right 60px

.verified-tag
  height 20px
  line-height 20px
  margin-top -2px

.security
  padding 0 16px

  &-item
    display flex

    &-title
      margin-right 16px
      font-weight 500
      color var(--semi-color-text-1)
      padding-top 30px
      padding-bottom 20px

    &-content
      display flex
      width 0
      flex 1
      justify-content space-between
      border-bottom 1px solid var(--semi-color-border)
      padding-top 30px
      padding-bottom 20px

    &-placeholder
      color var(--semi-color-text-2)

.verified
  padding 0 16px

  > h5
    font-size 14px
    margin-top 16px

  &-enterprise
    padding 16px
    background-color var(--semi-color-fill-2)

    td
      width 30%
