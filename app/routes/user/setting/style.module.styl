// 原 .arco-avatar-trigger-icon-button 是 arco Upload 悬浮图标角标，antd Upload 无对应节点，
// 直接删除该规则（JSX 中也未渲染该角标）
// / The old .arco-avatar-trigger-icon-button was arco Upload's hover badge; antd Upload has no
// equivalent node and the JSX renders no such badge, so the rule is removed.

.info-content
  flex 1
  width 0
  margin-left 60px
  padding-right 60px

.verified-tag
  height 20px
  line-height 20px
  margin-top -2px

.security
  padding 0 16px

  &-item
    display flex

    &-title
      margin-right 16px
      font-weight 500
      color var(--ant-color-text-secondary)
      padding-top 30px
      padding-bottom 20px

    &-content
      display flex
      width 0
      flex 1
      justify-content space-between
      border-bottom 1px solid var(--ant-color-border)
      padding-top 30px
      padding-bottom 20px

    &-placeholder
      color var(--ant-color-text-tertiary)

.verified
  padding 0 16px

  > h5
    font-size 14px
    margin-top 16px

  &-enterprise
    padding 16px
    background-color var(--ant-color-fill-tertiary)

    td
      width 30%
