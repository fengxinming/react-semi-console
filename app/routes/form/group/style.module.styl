.container
  overflow hidden

  // antd Card：卡片根 .ant-card，卡体 .ant-card-body
  // / antd Card: card root .ant-card, card body .ant-card-body
  :global(.ant-card-body)
    padding 20px 20px 10px

  :global(.ant-card)
    margin-bottom 16px

.actions
  padding 12px 40px
  background-color var(--ant-color-bg-layout)
  display flex
  flex-direction row-reverse
  position fixed
  left 0
  right 0
  bottom 0
  box-shadow 0 -3px 12px rgba(0, 0, 0, 0.1)
  z-index 99
