.container
  overflow hidden

  // Semi Card：卡片根 .semi-card，卡体 .semi-card-body
  // / Semi Card: card root .semi-card, card body .semi-card-body
  :global(.semi-card-body)
    padding 20px 20px 10px

  :global(.semi-card)
    margin-bottom 16px

.actions
  padding 12px 40px
  background-color var(--semi-color-bg-0)
  display flex
  flex-direction row-reverse
  position fixed
  left 0
  right 0
  bottom 0
  box-shadow 0 -3px 12px rgba(0, 0, 0, 0.1)
  z-index 99
