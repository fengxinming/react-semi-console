.workplace
  display flex
  width 100%

.left
  flex 1
  min-width 0
  margin-right 16px

.right
  flex 0 0 280px
  min-width 0

@media (max-width 1200px)
  .workplace
    flex-direction column

  .left
    flex none
    width 100%
    margin-right 0
    margin-bottom 16px

  .right
    flex none
    width 100%

.caret-green
  color var(--semi-color-success)

.caret-red
  color var(--semi-color-danger)

// Overview 统计项
.stat
  &-item
    display flex
    align-items center
    padding-left 20px
    color var(--semi-color-text-0)

  &-icon
    display flex
    align-items center
    justify-content center
    width 54px
    height 54px
    background-color var(--semi-color-fill-1)
    border-radius 50%
    margin-right 12px

    :global
      .semi-icon
        font-size 27px

  &-col
    &:not(:last-child)
      border-right 1px solid var(--semi-color-border)

    @media (max-width 900px)
      width 50% !important

    @media (max-width 600px)
      width 100% !important

      &:not(:last-child)
        border-right none

  &-title
    font-size 12px
    color var(--semi-color-text-0)

  &-count
    font-size 22px
    font-weight 600
    color var(--semi-color-text-0)

  &-unit
    font-size 12px
    font-weight 400
    color var(--semi-color-text-1)
    margin-left 8px

.chart
  &-header
    display flex
    justify-content space-between
    margin-bottom 16px

  &-sub-title
    font-size 12px
    font-weight 400
    margin-left 4px
    color var(--semi-color-text-2)

// Overview
.growth-icon
  font-size 18px
  color var(--semi-color-success)

// Shortcuts
.shortcut
  &-list
    display grid
    grid-template-columns 33.33% 33.33% 33.33%

  &-item
    display flex
    flex-direction column
    align-items center
    justify-content center
    padding 12px
    box-sizing border-box
    cursor pointer

    ^[1]:hover ^[0]-icon
      background-color var(--semi-color-primary-light-default)

      svg
        color var(--semi-color-primary)

    ^[1]:hover ^[0]-title
      color var(--semi-color-primary)

  &-icon
    display flex
    justify-content center
    align-items center
    width 32px
    height 32px
    border-radius 6px
    background-color var(--semi-color-fill-1)
    margin-bottom 4px

    svg
      font-size 18px

  &-title
    font-size 12px
    line-height 20px
    color var(--semi-color-text-0)

.recent
  font-weight 500
  font-size 16px
  line-height 24px
  color var(--semi-color-text-0)
  margin-bottom 16px

// Carousel
.carousel
  width 100%
  height 160px

  &-img
    width 100%
    transform translateY(-30px)

// Announcement
.announcement
  &-item
    display flex
    align-items center
    width 100%
    height 24px
    margin-bottom 4px

  &-text
    flex 1
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    margin-left 4px
    color var(--semi-color-text-1)
    text-decoration none
    font-size 13px
    cursor pointer

// Docs
.docs
  display grid
  grid-template-columns 50% 50%

.doc-link
  color var(--semi-color-text-1)
  padding 4px
  box-sizing border-box
  margin-bottom 12px

  &:hover
    color var(--semi-color-primary)
