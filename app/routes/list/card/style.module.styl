.container
  :global
    // 旧的 list-content / card-meta-title 规则在本页没有对应节点
    // （本页未使用 List / Card.Meta），已删除
    // / The old list-content and card-meta-title rules had no matching nodes here
    // (this page uses neither List nor Card.Meta), so they were removed

    // 分组标题由 Semi Typography.Title heading={5} 渲染，对应 h5.semi-typography
    // / group headings come from Semi Typography.Title heading={5} → h5.semi-typography
    h5.semi-typography
      font-size 14px
      margin-top 16px
      margin-bottom 12px

.card-block
  margin-bottom 16px

  // Semi Card 头部 = .semi-card-header（卡片标题容器，默认 20px 内边距）
  // / Semi card head = .semi-card-header (title container, 20px padding by default)
  :global(.semi-card-header)
    height auto
    padding 16px
    padding-bottom 0

  &:hover
    box-shadow 4px 4px 10px rgba(0, 0, 0, 10%)

    .title
      .more
        opacity 1

  .title
    display flex
    line-height 24px
    align-items center
    font-size 14px
    font-weight 500

    .icon
      height 24px
      width 24px
      // 圆形图标底色跟随主题主色，文字用「实底上的文本」token
      // / icon badge follows the theme primary; text uses the on-solid text token
      color var(--semi-color-white)
      background var(--semi-color-primary)
      text-align center
      line-height 24px
      border-radius 50%
      margin-right 8px

    .more
      color var(--semi-color-text-3)
      font-size 16px
      position absolute
      right 16px
      cursor pointer
      opacity 0

  .title-more
    .more
      opacity 1

  // Semi Descriptions 单元格：标签是 th.semi-descriptions-item-th，内容是 td.semi-descriptions-item-td
  // / Semi Descriptions cells: label is th.semi-descriptions-item-th, value is td.semi-descriptions-item-td
  .time, .content > :global(.semi-typography), :global(.semi-descriptions-item-th), :global(.semi-descriptions-item-td)
    font-size 12px
    font-weight 400
    color var(--semi-color-text-2)
    padding 0
    line-height 20px

  :global(.semi-descriptions-item-td)
    color var(--semi-color-text-1)
    padding-left 6px

  .content
    height 48px

  &-skeleton
    // Semi Skeleton.Paragraph 的占位行 = .semi-skeleton-paragraph 下的 li
    // / Semi Skeleton.Paragraph placeholder rows = li inside .semi-skeleton-paragraph
    :global(.semi-skeleton-paragraph > li:not(:last-child))
      height 14px
      margin-bottom 8px

.add-card
  text-align center
  cursor pointer

  .description
    margin-top 16px
    color var(--semi-color-text-2)
    font-weight 400

  // Semi Card 卡体 / Semi card body
  :global(.semi-card-body)
    padding-top 52px
    padding-bottom 64px