.search-form-wrapper
  display flex
  border-bottom 1px solid var(--semi-color-border)
  margin-bottom 20px

  .right-button
    display flex
    flex-direction column
    justify-content space-between
    padding-left 20px
    margin-bottom 20px
    border-left 1px solid var(--semi-color-border)
    box-sizing border-box

.search-form
  padding-right 20px

  // Semi Form labelAlign="left" 把类直接加在 <label> 上（.semi-form-field-label-left），
  // 因此这里直接选中该元素
  // / Semi Form labelAlign="left" puts the class on the <label> itself
  // (.semi-form-field-label-left), so it is targeted directly here
  :global(.semi-form-field-label-left)
    white-space nowrap

.content-type
  display flex

  > svg
    margin-right 8px
    margin-top 4px