.search-form-wrapper
  display flex
  border-bottom 1px solid var(--ant-color-border-secondary)
  margin-bottom 20px

  .right-button
    display flex
    flex-direction column
    justify-content space-between
    padding-left 20px
    margin-bottom 20px
    border-left 1px solid var(--ant-color-border-secondary)
    box-sizing border-box

.search-form
  padding-right 20px

  // antd Form.Item 左对齐标签 = .ant-form-item-label-left
  // / antd left-aligned form label = .ant-form-item-label-left
  :global(.ant-form-item-label-left)
    > label
      white-space nowrap

.content-type
  display flex

  > svg
    margin-right 8px
    margin-top 4px