html, body
  width 100%
  height 100%
  margin 0
  padding 0
  font-size 12px

// antd v6 的 cssVar 作用域：--ant-* 变量注册在「主题 key 类名 + 组件根类名」组成的
// 选择器上（源码 cssinjs serializeCSSVar：`:where(.<hash>).<cssVar.key>.<scope>`），
// 该作用域类由 antd 各组件根节点自动携带。html/body 不在作用域内，
// 因此原先挂在 html/body 上的 var(--ant-color-bg-layout) 永远解析失败 → 背景透明，
// 深色模式下就会透出浏览器默认白底，与白色文字形成「白底白字」。
// 把页面底色挂到 <App> 渲染的 .ant-app 根节点（携带作用域、且铺满视口），
// 深浅色统一由 token 驱动，不写死色值。
// / antd v6 registers --ant-* vars on a selector built from `theme key class + component
// root class` (see cssinjs serializeCSSVar), carried by antd component roots. html/body are
// outside that scope, so the old `var(--ant-color-bg-layout)` on html/body never resolved and
// left the page transparent (white canvas in dark mode). Move it to the <App> root.
.ant-app
  min-height 100%
  background-color var(--ant-color-bg-layout)

.chart-wrapper
  .g2-tooltip
    background linear-gradient(
      304.17deg,
      rgb(253 254 255 / 60%) -6.04%,
      rgb(244 247 252 / 60%) 85.2%
    ) !important
    border-radius 6px
    backdrop-filter blur(10px)
    padding 8px !important
    width 180px !important
    opacity 1 !important

body[theme-mode='dark']
  .chart-wrapper
    .g2-tooltip
      background linear-gradient(
        304.17deg,
        rgba(90, 92, 95, 0.6) -6.04%,
        rgba(87, 87, 87, 0.6) 85.2%
      ) !important
      backdrop-filter blur(10px)
      border-radius 6px
      box-shadow none !important

.ant-card
  h1.ant-typography, .ant-typography-h1, h2.ant-typography, .ant-typography-h2, h3.ant-typography, .ant-typography-h3, h4.ant-typography, .ant-typography-h4, h5.ant-typography, .ant-typography-h5, h6.ant-typography, .ant-typography-h6
    margin-top 0
    margin-bottom 16px

.ant-form-item-required
  display inline
  vertical-align baseline

/* nprogress 导航进度条：官方默认蓝 #29d 改为项目主题色。
   #nprogress 挂在 body 下，不在 antd cssVar 作用域内，故用 commons/html.ts 的 setThemeColor
   同步到 body 上的 --app-color-primary（取值即 antd colorPrimary），
   而不是 var(--ant-color-primary)。
   / nprogress bar: replace the default blue with the project primary color. #nprogress lives
   under body, outside antd's cssVar scope, so setThemeColor (commons/html.ts) mirrors the color
   onto --app-color-primary on body instead of relying on var(--ant-color-primary). */
#nprogress
  .bar
    background var(--app-color-primary)

  .peg
    box-shadow 0 0 10px var(--app-color-primary), 0 0 5px var(--app-color-primary)
