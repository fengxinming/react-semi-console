html, body
  width 100%
  height 100%
  margin 0
  padding 0
  font-size 12px

// Semi 把亮/暗两套色盘挂在 body 上（--semi-color-bg-* 等），body 本身在作用域内。
// 页面底色直接用 Semi 的背景变量，明暗切换（body[theme-mode='dark']）时自动跟随。
// / Semi mounts both light/dark palettes on body (--semi-color-bg-*), so body itself is in scope.
html, body
  min-height 100%
  color var(--semi-color-text-0)
  background-color var(--semi-color-bg-0)

.chart-wrapper
  .g2-tooltip
    background linear-gradient(
      304.17deg,
      rgb(253 254 255 / 60%) -6.04%,
      rgb(244 247 252 / 60%) 85.2%
    ) !important
    border-radius 6px
    backdrop-filter blur(10px)
    padding 8px !important
    width 180px !important
    opacity 1 !important

body[theme-mode='dark']
  .chart-wrapper
    .g2-tooltip
      background linear-gradient(
        304.17deg,
        rgba(90, 92, 95, 0.6) -6.04%,
        rgba(87, 87, 87, 0.6) 85.2%
      ) !important
      backdrop-filter blur(10px)
      border-radius 6px
      box-shadow none !important

.semi-card
  h1, h2, h3, h4, h5, h6
    margin-top 0
    margin-bottom 16px

.semi-form-field-label-required
  display inline
  vertical-align baseline

/* nprogress 导航进度条：官方默认蓝 #29d 改为项目主题色。
#nprogress 挂在 body 下，commons/html.ts 的 setThemeColor 把主色同步到
body 上的 --semi-color-primary，与 Semi 主色保持一致。 */
#nprogress
  .bar
    background var(--semi-color-primary)

  .peg
    box-shadow 0 0 10px var(--semi-color-primary), 0 0 5px var(--semi-color-primary)
